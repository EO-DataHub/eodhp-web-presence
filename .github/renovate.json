{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>EO-DataHub/github-actions//renovate.json5"],
  "packageRules": [
    {
      "matchPackageNames": ["stylelint", "/^stylelint-/"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "groupName": "stylelint"
    },
    {
      "description": "wagtail-cache imports django.utils.cache.cc_delim_re, removed in Django 6.1; drop once coderedcorp/wagtail-cache#88 ships",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["Django"],
      "allowedVersions": "<6.1"
    }
  ]
}
